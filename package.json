{
  "name": "ai-universe-living-blog",
  "version": "0.1.0",
  "description": "AO worker living blog + novel engine — per-repo PR lifecycle feed with serialized fiction",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./blog-server": {
      "types": "./dist/blog/server.d.ts",
      "import": "./dist/blog/server.js"
    },
    "./blog-storage": {
      "types": "./dist/blog/storage.d.ts",
      "import": "./dist/blog/storage.js"
    },
    "./novel-engine": {
      "types": "./dist/novel/engine.d.ts",
      "import": "./dist/novel/engine.js"
    },
    "./shared": {
      "types": "./dist/shared/types.d.ts",
      "import": "./dist/shared/types.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/jleechanorg/ai_universe_living_blog"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc",
    "dev:blog": "tsx --watch src/blog/server.ts",
    "dev:novel": "tsx --watch src/novel/cli.ts",
    "start:novel": "tsx src/novel/cli.ts",
    "dev": "npm run dev:blog",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "presubmit": "npm run typecheck && npm run lint && npm run build && npm run test",
    "run-local-server": "tsx scripts/run-local-server.ts",
    "install:blog": "bash scripts/install-blog.sh",
    "install:novel": "bash scripts/install-novel.sh",
    "install:all": "bash install.sh",
    "test:install": "vitest run tests/install.test.ts"
  },
  "dependencies": {
    "@ai-universe/mcp-server-utils": "^1.0.2",
    "@google-cloud/firestore": "^8.3.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.0.0",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.8",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.4.0"
  }
}
